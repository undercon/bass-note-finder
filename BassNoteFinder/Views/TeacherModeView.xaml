<UserControl x:Class="BassNoteFinder.Views.TeacherModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="TeacherModeView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="15,15,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="FeedbackBorder" Grid.Row="0" Height="76" Style="{StaticResource ModeHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FeedbackIcon" Visibility="Collapsed" FontSize="30" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TEACHER MODE · PICK THE TARGET" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock x:Name="StatusText" Text="Click the staff to place a note, or press Random."
                               Style="{StaticResource StatusTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Staff" Style="{StaticResource PanelTitleTextStyle}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10,30,10,10">
                        <Canvas x:Name="StaffCanvas" Width="670" Height="200"
                                Background="Transparent"
                                MouseLeftButtonDown="StaffCanvas_MouseLeftButtonDown"
                                MouseMove="StaffCanvas_MouseMove"
                                MouseLeave="StaffCanvas_MouseLeave"/>
                    </Viewbox>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Fretboard" Style="{StaticResource PanelTitleTextStyle}"/>

                    <Grid x:Name="FretboardPanel" Grid.Row="1" Visibility="Hidden" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <Canvas x:Name="FretboardCanvas" Width="670" Height="260" Background="{DynamicResource FretboardWoodBrush}"/>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ModeOptionsBorderStyle}">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Options" Style="{StaticResource ToolbarLabelTextStyle}"/>
                <CheckBox x:Name="ShowNoteNamesCheckBox" Content="Show note labels"
                          ToolTip="Show the note name beside the target on the staff"
                          Style="{StaticResource ToolbarCheckBoxStyle}"
                          IsChecked="False"
                          Checked="ShowNoteNamesCheckBox_Changed"
                          Unchecked="ShowNoteNamesCheckBox_Changed"/>
                <CheckBox x:Name="IncludeAccidentalsCheckBox" Content="Accidental notes"
                          ToolTip="Allow sharp and flat targets as well as natural notes"
                          Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                          Checked="IncludeAccidentalsCheckBox_Changed"
                          Unchecked="IncludeAccidentalsCheckBox_Changed"/>
                <CheckBox x:Name="IncludeOctavesCheckBox" Content="Match octave"
                          ToolTip="Require the played note to be in the same octave as the target"
                          Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                          Checked="IncludeOctavesCheckBox_Changed"
                          Unchecked="IncludeOctavesCheckBox_Changed"/>
                <CheckBox x:Name="RevealTargetOnMissCheckBox" Content="Reveal target on miss"
                          ToolTip="Show the correct fret in green alongside a missed note"
                          Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                          Checked="RevealTargetOnMissCheckBox_Changed"
                          Unchecked="RevealTargetOnMissCheckBox_Changed"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <Button x:Name="RandomBtn" Content="Random note" Width="124" Click="RandomBtn_Click"
                            Margin="0,0,8,0" Style="{StaticResource SuccessActionButtonStyle}"/>
                    <Button x:Name="BackToModeSelectionBtn" Content="Modes" Width="104" Click="BackToModeSelectionBtn_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                </StackPanel>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
