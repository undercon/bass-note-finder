<UserControl x:Class="BassNoteFinder.Views.StudentModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="StudentModeView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="15,15,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ModeHeaderBorderStyle}">
            <StackPanel>
                <TextBlock Text="STUDENT MODE · HEAR, FIND, PLAY" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Name="StatusText" Text="Play the shown note."
                           Style="{StaticResource StatusTextStyle}"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Staff" Style="{StaticResource PanelTitleTextStyle}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10,30,10,10">
                        <Canvas x:Name="StaffCanvas" Width="670" Height="200" Background="Transparent"/>
                    </Viewbox>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Fretboard" Style="{StaticResource PanelTitleTextStyle}"/>

                    <StackPanel x:Name="OverlayPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,10">
                        <TextBlock x:Name="OverlayIcon" Text="?" FontSize="48" Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OverlayText" Text="Play the note to reveal" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid x:Name="FretboardPanel" Grid.Row="2" Visibility="Hidden" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10">
                            <Canvas x:Name="FretboardCanvas" Width="670" Height="200" Background="{DynamicResource FretboardWoodBrush}"/>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ModeOptionsBorderStyle}">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Options" Style="{StaticResource ToolbarLabelTextStyle}"/>
                    <CheckBox x:Name="ShowNoteNamesCheckBox" Content="Show note labels"
                              ToolTip="Show the target note name beside the staff"
                              Style="{StaticResource ToolbarCheckBoxStyle}"
                              IsChecked="False"
                              Checked="ShowNoteNamesCheckBox_Changed"
                              Unchecked="ShowNoteNamesCheckBox_Changed"/>
                    <CheckBox x:Name="IncludeAccidentalsCheckBox" Content="Accidental notes"
                              ToolTip="Include sharp and flat targets in the exercise"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="IncludeAccidentalsCheckBox_Changed"
                              Unchecked="IncludeAccidentalsCheckBox_Changed"/>
                    <CheckBox x:Name="IncludeOctavesCheckBox" Content="Match octave"
                              ToolTip="Require the played note to be in the same octave as the target"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="IncludeOctavesCheckBox_Changed"
                              Unchecked="IncludeOctavesCheckBox_Changed"/>
                    <CheckBox x:Name="AdaptivePracticeCheckBox" Content="Adaptive coach"
                              ToolTip="Revisits notes that need work while keeping the exercise varied"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="AdaptivePracticeCheckBox_Changed"
                              Unchecked="AdaptivePracticeCheckBox_Changed"/>
                    <CheckBox x:Name="AutoAdvanceCheckBox" Content="Auto next"
                              ToolTip="Automatically present the next target after a correct answer"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="True"
                              Checked="AutoAdvanceCheckBox_Changed"
                              Unchecked="AutoAdvanceCheckBox_Changed"/>
                    <TextBlock Text="Delay" Style="{StaticResource ToolbarLabelTextStyle}"/>
                    <Slider x:Name="NextNoteDelaySlider" Width="108" Minimum="1" Maximum="10" Value="3"
                            ToolTip="How long to show a correct answer before the next target appears"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="NextNoteDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="NextNoteDelayValueText" Text="3s" VerticalAlignment="Center" Foreground="{DynamicResource PanelHeaderBrush}" Margin="4,4,8,4"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <Button x:Name="RandomBtn" Content="Random note" Width="124" Click="RandomBtn_Click"
                                Margin="0,0,8,0" Style="{StaticResource SuccessActionButtonStyle}"/>
                        <Button x:Name="BackToModeSelectionBtn" Content="Modes" Width="104" Click="BackToModeSelectionBtn_Click"
                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="Notes" Style="{StaticResource ToolbarLabelTextStyle}"
                               ToolTip="Choose which note names can appear as Student-mode targets"/>
                    <CheckBox x:Name="NoteCCheckBox" Content="C" Tag="0" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteCsCheckBox" Content="C#" Tag="1" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteDCheckBox" Content="D" Tag="2" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteDsCheckBox" Content="D#" Tag="3" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteECheckBox" Content="E" Tag="4" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteFCheckBox" Content="F" Tag="5" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteFsCheckBox" Content="F#" Tag="6" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteGCheckBox" Content="G" Tag="7" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteGsCheckBox" Content="G#" Tag="8" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteACheckBox" Content="A" Tag="9" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteAsCheckBox" Content="A#" Tag="10" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteBCheckBox" Content="B" Tag="11" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
