<UserControl x:Class="BassNoteFinder.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,8,0" Padding="8,4"
                Style="{StaticResource StatusPillBorderStyle}">
            <TextBlock x:Name="VersionText"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Text="v0.0.0"/>
        </Border>

        <StackPanel Width="520">
            <TextBlock Text="Bass Note Finder" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Choose a practice mode" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <UniformGrid Columns="2" Rows="1">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid Height="178">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Teacher Mode" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Grid.Row="1" Text="You pick the target note on staff, then play it on bass."
                                   Margin="0,8,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Open Teacher"
                                Click="TeacherModeButton_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid Height="178">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Student Mode" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Grid.Row="1" Text="Random notes are assigned automatically; focus on fast accurate hits."
                                   Margin="0,8,0,12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <Button Grid.Row="2" Content="Open Student"
                                Click="StudentModeButton_Click"
                                Style="{StaticResource SuccessActionButtonStyle}"/>
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
