<Window x:Class="BassNoteFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bass Note Finder" Height="750" Width="1050"
        Icon="Assets/AppIcon.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PanelHeaderBrush}"
        FontFamily="Segoe UI" FontSize="14"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AppStyles.xaml"/>
                <ResourceDictionary Source="Resources/DarkComboBoxResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" x:Name="MainContent"/>

        <Border Grid.Row="1" Style="{StaticResource ControlBarBorderStyle}">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4">
                    <TextBlock Text="Input" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="InputCombo" Width="250"
                              SelectionChanged="InputCombo_SelectionChanged"
                              Style="{StaticResource DarkInputComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,4,6,4">
                    <TextBlock Text="Gate" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0"/>
                    <Slider x:Name="ThresholdSlider" Width="125" Minimum="0.005" Maximum="0.02"
                            SmallChange="0.001" LargeChange="0.002"
                            TickFrequency="0.001" IsSnapToTickEnabled="False"
                            ValueChanged="ThresholdSlider_ValueChanged"/>
                    <TextBlock x:Name="ThresholdValueText" Width="40" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource PanelHeaderBrush}" TextAlignment="Right"/>
                </StackPanel>

                <CheckBox x:Name="HarmonicCorrectionCheckBox" Content="Bass Harmonics"
                          Style="{StaticResource ToolbarCheckBoxStyle}"
                          Checked="HarmonicCorrectionCheckBox_Changed"
                          Unchecked="HarmonicCorrectionCheckBox_Changed"/>

                <Button x:Name="ToggleMicBtn" Content="Start Mic"
                        Width="112" Click="ToggleMic_Click" Margin="10,4"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>

                <Border Style="{StaticResource StatusPillBorderStyle}" Margin="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SignalDot" Width="12" Height="12" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource SecondaryBrush}"
                                 Stroke="{DynamicResource PanelBorderBrush}" StrokeThickness="1"/>
                        <TextBlock Text="Detected" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DetectedNoteText" Text="--" 
                                   Width="130" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ShowDeviationCheckBox" Content="Deviation"
                          Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                          Checked="ShowDeviationCheckBox_Changed"
                          Unchecked="ShowDeviationCheckBox_Changed"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,6,4">
                    <TextBlock Text="Theme" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="96"
                              SelectionChanged="ThemeCombo_SelectionChanged"
                              Style="{StaticResource DarkInputComboBoxStyle}"/>
                </StackPanel>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
