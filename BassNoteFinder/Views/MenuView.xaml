<UserControl x:Class="BassNoteFinder.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,8,0" Padding="8,4"
                Style="{StaticResource StatusPillBorderStyle}">
            <TextBlock x:Name="VersionText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Text="v0.0.0"/>
        </Border>

        <StackPanel Width="680">
            <TextBlock Text="{DynamicResource MenuEyebrow}" Style="{StaticResource EyebrowTextStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource AppTitle}" Style="{StaticResource PageTitleTextStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource MenuTagline}"
                       FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <UniformGrid Columns="2" Rows="1">
                <Border Style="{StaticResource CardBorderStyle}" Padding="24"
                        Background="{DynamicResource TeacherCardBackgroundBrush}"
                        BorderBrush="{DynamicResource TeacherCardBorderBrush}">
                    <Grid Height="206">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource Guide}" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="{DynamicResource TeacherMode}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelHeaderBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource TeacherDescription}"
                                   Margin="0,12,0,16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="14"/>
                        <Button Grid.Row="2" Content="{DynamicResource ChooseTeacher}"
                                Click="TeacherModeButton_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="24"
                        Background="{DynamicResource StudentCardBackgroundBrush}"
                        BorderBrush="{DynamicResource StudentCardBorderBrush}">
                    <Grid Height="206">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource Train}" Style="{StaticResource EyebrowTextStyle}"
                                       Foreground="{DynamicResource WarmAccentBrush}"/>
                            <TextBlock Text="{DynamicResource StudentMode}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelHeaderBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{DynamicResource StudentDescription}"
                                   Margin="0,12,0,16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="14"/>
                        <Button Grid.Row="2" Content="{DynamicResource StartStudent}"
                                Click="StudentModeButton_Click"
                                Style="{StaticResource SuccessActionButtonStyle}"/>
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
