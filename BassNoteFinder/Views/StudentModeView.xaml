<UserControl x:Class="BassNoteFinder.Views.StudentModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="StudentModeView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="15,15,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="FeedbackBorder" Grid.Row="0" Height="76" Style="{StaticResource ModeHeaderBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FeedbackIcon" Visibility="Collapsed" FontSize="30" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource StudentEyebrow}" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource StudentStart}"
                               Style="{StaticResource StatusTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Staff}" Style="{StaticResource PanelTitleTextStyle}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="10,30,10,10">
                        <Canvas x:Name="StaffCanvas" Width="670" Height="200" Background="Transparent"/>
                    </Viewbox>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Fretboard}" Style="{StaticResource PanelTitleTextStyle}"/>

                    <Grid x:Name="FretboardPanel" Grid.Row="1" Visibility="Hidden" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <Canvas x:Name="FretboardCanvas" Width="670" Height="260" Background="{DynamicResource FretboardWoodBrush}"/>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ModeOptionsBorderStyle}">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Practice}" Style="{StaticResource ToolbarLabelTextStyle}"/>
                    <CheckBox x:Name="ShowNoteNamesCheckBox" Content="{DynamicResource ShowLabels}"
                              ToolTip="{DynamicResource TooltipShowLabels}"
                              Style="{StaticResource ToolbarCheckBoxStyle}"
                              IsChecked="False"
                              Checked="ShowNoteNamesCheckBox_Changed"
                              Unchecked="ShowNoteNamesCheckBox_Changed"/>
                    <CheckBox x:Name="IncludeAccidentalsCheckBox" Content="{DynamicResource Accidentals}"
                              ToolTip="{DynamicResource TooltipAccidentalsStudent}"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="IncludeAccidentalsCheckBox_Changed"
                              Unchecked="IncludeAccidentalsCheckBox_Changed"/>
                    <CheckBox x:Name="IncludeOctavesCheckBox" Content="{DynamicResource MatchOctave}"
                              ToolTip="{DynamicResource TooltipOctave}"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="True"
                              Checked="IncludeOctavesCheckBox_Changed"
                              Unchecked="IncludeOctavesCheckBox_Changed"/>
                    <CheckBox x:Name="RevealTargetOnMissCheckBox" Content="{DynamicResource RevealTarget}"
                              ToolTip="{DynamicResource TooltipReveal}"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="RevealTargetOnMissCheckBox_Changed"
                              Unchecked="RevealTargetOnMissCheckBox_Changed"/>
                    <TextBlock Text="{DynamicResource Coach}" Style="{StaticResource ToolbarLabelTextStyle}" Margin="20,4,4,4"/>
                    <CheckBox x:Name="AdaptivePracticeCheckBox" Content="{DynamicResource AdaptiveCoach}"
                              ToolTip="{DynamicResource TooltipAdaptive}"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="False"
                              Checked="AdaptivePracticeCheckBox_Changed"
                              Unchecked="AdaptivePracticeCheckBox_Changed"/>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource Flow}" Style="{StaticResource ToolbarLabelTextStyle}"/>
                    <CheckBox x:Name="AutoAdvanceCheckBox" Content="{DynamicResource AutoNext}"
                              ToolTip="{DynamicResource TooltipAutoNext}"
                              Style="{StaticResource ToolbarCheckBoxStyle}" IsChecked="True"
                              Checked="AutoAdvanceCheckBox_Changed"
                              Unchecked="AutoAdvanceCheckBox_Changed"/>
                    <TextBlock Text="{DynamicResource Delay}" Style="{StaticResource ToolbarLabelTextStyle}"/>
                    <Slider x:Name="NextNoteDelaySlider" Width="108" Minimum="0.5" Maximum="5" Value="3"
                            ToolTip="{DynamicResource TooltipDelay}"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="NextNoteDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="NextNoteDelayValueText" Text="3s" VerticalAlignment="Center" Foreground="{DynamicResource PanelHeaderBrush}" Margin="4,4,8,4"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button x:Name="RandomBtn" Content="{DynamicResource RandomNote}" Width="124" Click="RandomBtn_Click"
                                Margin="0,0,8,0" Style="{StaticResource SuccessActionButtonStyle}"/>
                        <Button x:Name="BackToModeSelectionBtn" Content="{DynamicResource Modes}" Width="104" Click="BackToModeSelectionBtn_Click"
                                Style="{StaticResource SecondaryActionButtonStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource Notes}" Style="{StaticResource ToolbarLabelTextStyle}"
                               ToolTip="{DynamicResource TooltipNotes}"/>
                    <CheckBox x:Name="NoteCCheckBox" Content="C" Tag="0" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteCsCheckBox" Content="C#" Tag="1" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteDCheckBox" Content="D" Tag="2" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteDsCheckBox" Content="D#" Tag="3" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteECheckBox" Content="E" Tag="4" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteFCheckBox" Content="F" Tag="5" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteFsCheckBox" Content="F#" Tag="6" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteGCheckBox" Content="G" Tag="7" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteGsCheckBox" Content="G#" Tag="8" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteACheckBox" Content="A" Tag="9" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteAsCheckBox" Content="A#" Tag="10" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                    <CheckBox x:Name="NoteBCheckBox" Content="B" Tag="11" Style="{StaticResource ToolbarCheckBoxStyle}"
                              Checked="AvailableNoteCheckBox_Changed" Unchecked="AvailableNoteCheckBox_Changed"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
